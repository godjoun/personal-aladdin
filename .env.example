# ALADDIN — 환경 변수 예시
# 사용: 이 파일을 복사해 ".env" 로 저장 후 값을 채우세요.
# 주의: 실제 .env 는 git 에 커밋하지 마세요.
# API_KEY / KIWOOM_* / ALADDIN_* secret 은 Express 서버(process.env)에서만 사용합니다.
# VITE_ 접두사는 사용하지 마세요 (클라이언트 번들 노출 방지).

# 공공데이터
BASE_URL=https://apis.data.go.kr/1160100/service/GetSecuritiesProductInfoService/getETFPriceInfo
STOCK_BASE_URL=https://apis.data.go.kr/1160100/service/GetStockSecuritiesInfoService/getStockPriceInfo
API_KEY=

# ALADDIN server
CENTRAL_PORT=3001

# 단일 사용자 인증 (평문 비밀번호 저장 금지)
# 초보자: npm run auth:setup 한 번으로 아래 3키 자동 설정
# 수동: npm run auth:hash 로 해시만 생성 후 붙여넣기
ALADDIN_ADMIN_USERNAME=
ALADDIN_ADMIN_PASSWORD_HASH=
ALADDIN_SESSION_SECRET=

# SQLite 영속 경로 (production / Render 필수)
# Render persistent disk mount 예: /var/data
# ALADDIN_DB_PATH=/var/data/aladdin.sqlite
# ALADDIN_BACKUP_DIR=/var/data/backups
# ALADDIN_DATA_DIR=

# 배포 시 reverse proxy 뒤라면 1 (Render: ALADDIN_TRUST_PROXY=1)
# ALADDIN_TRUST_PROXY=1

# 개발 CORS allowlist (쉼표 구분). production same-origin이면 비워 둠.
# ALADDIN_ALLOWED_ORIGIN=http://localhost:5173

# Kiwoom REST API (ISA / 일반 계좌 — 서버 전용, 조회만)
KIWOOM_ISA_APP_KEY=
KIWOOM_ISA_APP_SECRET=
KIWOOM_GENERAL_APP_KEY=
KIWOOM_GENERAL_APP_SECRET=
